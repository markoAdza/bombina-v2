---
import Icon from './Icon.astro';
import { copy } from '../i18n/copy';
import type { Lang } from '../i18n/utils';
import { site } from '../data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = copy[lang].visit;
---

<div class="map" data-map data-src={site.mapsEmbed} data-title={c.mapTitle}>
  <!-- Illustrated stand-in: no Google request until the visitor asks for the map -->
  <svg class="map__art" viewBox="0 0 600 450" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <rect width="600" height="450" class="map__ground" />
    <path class="map__river" d="M-20 380 C 120 330, 180 410, 300 360 S 520 300, 640 340" />
    <path class="map__road map__road--main" d="M-20 120 C 140 160, 260 120, 340 190 S 470 300, 640 260" />
    <path class="map__road" d="M90 -20 C 120 120, 150 240, 120 470" />
    <path class="map__road" d="M420 -20 C 400 100, 330 180, 340 190 C 360 260, 380 380, 360 470" />
    <path class="map__road map__road--thin" d="M-20 270 C 100 250, 200 300, 340 190" />
    <path class="map__road map__road--thin" d="M480 -20 C 520 120, 560 200, 640 210" />
    <g class="map__blocks">
      <rect x="160" y="40" width="70" height="44" rx="6" />
      <rect x="250" y="20" width="56" height="70" rx="6" />
      <rect x="440" y="140" width="80" height="54" rx="6" />
      <rect x="180" y="250" width="64" height="48" rx="6" />
      <rect x="440" y="330" width="90" height="40" rx="6" />
      <rect x="20" y="170" width="54" height="60" rx="6" />
    </g>
  </svg>

  <div class="map__pin" aria-hidden="true">
    <span class="mark mark--frog map__frog"></span>
  </div>

  <div class="map__panel">
    <p class="map__address">
      <strong>{site.name}</strong>
      <span>{site.address.street}, {site.address.postalCode} {site.address.city}</span>
    </p>
    <div class="map__actions">
      <button class="btn btn--sm" type="button" data-map-load>
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m3 6 6-3 6 3 6-3v15l-6 3-6-3-6 3z" /><path d="M9 3v15" /><path d="M15 6v15" /></svg>
        <span class="btn__label"><span>{c.mapButton}</span><span aria-hidden="true">{c.mapButton}</span></span>
      </button>
      <a class="link-arrow" href={site.mapsUrl} target="_blank" rel="noopener noreferrer">
        <span>Google Maps</span>
        <Icon name="arrow-right" />
      </a>
    </div>
  </div>
</div>

<style>
  .map {
    position: relative;
    height: 100%;
    min-height: 420px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--sage-soft);
  }

  .map__art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .map__ground {
    fill: var(--sage-soft);
  }

  .map__river {
    fill: none;
    stroke: var(--sage);
    stroke-width: 26;
    stroke-linecap: round;
  }

  .map__road {
    fill: none;
    stroke: var(--surface);
    stroke-width: 12;
    stroke-linecap: round;
  }

  .map__road--main {
    stroke-width: 18;
  }

  .map__road--thin {
    stroke-width: 7;
  }

  .map__blocks rect {
    fill: var(--beige);
    opacity: 0.7;
  }

  .map__pin {
    position: absolute;
    left: 56%;
    top: 36%;
    display: grid;
    place-items: center;
    width: 76px;
    height: 76px;
    translate: -50% -50%;
    border-radius: 50% 50% 50% 4px;
    rotate: -45deg;
    background: var(--ink);
    box-shadow: var(--shadow-tile);
  }

  .map__frog {
    height: 50px;
    color: var(--on-dark);
    rotate: 45deg;
  }

  .map__panel {
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    display: grid;
    gap: 0.85rem;
    padding: 1.25rem;
    background: rgba(var(--surface-rgb), 0.94);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    backdrop-filter: blur(8px);
  }

  .map__address {
    display: grid;
    gap: 0.15rem;
    color: var(--ink-soft);
  }

  .map__address strong {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 450;
  }

  .map__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }

  .map__consent {
    color: var(--ink-muted);
    font-size: 0.8125rem;
  }

  .map :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    filter: saturate(0.75) sepia(0.12);
  }

  .map.is-loaded .map__panel,
  .map.is-loaded .map__pin {
    display: none;
  }
</style>
