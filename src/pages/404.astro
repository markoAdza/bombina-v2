---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { copy } from '../i18n/copy';
import { href } from '../i18n/utils';

const sl = copy.sl;
const en = copy.en;
---

<BaseLayout lang="sl" title="404 — Bistro Bombina" description={sl.notFound.body} routeKey={null}>
  <section class="nf section grain">
    <div class="container--narrow nf__inner">
      <div class="nf__pond" aria-hidden="true">
        <span class="mark mark--frog nf__frog"></span>
        <span class="nf__ripple"></span>
        <span class="nf__ripple nf__ripple--2"></span>
      </div>
      <p class="eyebrow eyebrow--plain">404</p>
      <h1 class="h2" set:html={sl.notFound.title} />
      <p class="lead">{sl.notFound.body}</p>
      <p class="nf__en" lang="en"><span set:html={en.notFound.title} /> {en.notFound.body}</p>
      <div class="btn-row nf__actions">
        <Button href={href('menu', 'sl')} icon="arrow-right">{sl.common.menu}</Button>
        <Button href={href('home', 'sl')} variant="ghost">{sl.common.home}</Button>
        <Button href={href('home', 'en')} variant="ghost">English</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    min-height: 80vh;
    display: grid;
    align-items: center;
    padding-top: calc(var(--section-y) * 0.6);
  }

  .nf__inner {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    text-align: center;
  }

  .nf__pond {
    position: relative;
    display: grid;
    place-items: center;
    width: 220px;
    height: 170px;
  }

  .nf__frog {
    position: relative;
    z-index: 1;
    height: 150px;
    color: var(--ink);
    animation: bob 3.2s var(--ease-in-out) infinite;
  }

  .nf__ripple {
    position: absolute;
    bottom: 4px;
    width: 200px;
    height: 34px;
    border: 2px solid var(--sage);
    border-radius: 50%;
    animation: ripple 3.2s var(--ease-out) infinite;
  }

  .nf__ripple--2 {
    animation-delay: 1.6s;
  }

  .nf__en {
    color: var(--ink-muted);
    font-size: 0.9375rem;
  }

  .nf__en :global(em) {
    font-style: italic;
  }

  .nf__actions {
    justify-content: center;
  }

  @keyframes bob {
    0%,
    100% {
      transform: translateY(0) rotate(-2deg);
    }
    50% {
      transform: translateY(-8px) rotate(2deg);
    }
  }

  @keyframes ripple {
    from {
      transform: scale(0.5);
      opacity: 0.9;
    }
    to {
      transform: scale(1.15);
      opacity: 0;
    }
  }
</style>
