---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import MenuList from '../components/MenuList.astro';
import Button from '../components/Button.astro';
import { copy } from '../i18n/copy';
import { anchorId, tx, formatPrice, formatDate, type Lang, type AnchorKey } from '../i18n/utils';
import { aLaCarte, weekly, desserts, seasonal, allergenLabels, menuUpdated, type MenuItem, type Allergen } from '../data/menu';
import { photos, ig } from '../data/images';
import { site, phoneFor } from '../data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = copy[lang];
const m = c.menuPage;

type SectionKey = 'alacarte' | 'weekly' | 'desserts';
const sections: { key: SectionKey; items: MenuItem[]; photo: { src: ImageMetadata; alt: string } }[] = [
  { key: 'alacarte', items: aLaCarte, photo: { src: ig('tartare-bread').src, alt: tx(ig('tartare-bread').alt, lang) } },
  { key: 'weekly', items: weekly, photo: { src: ig('seafood-tagliatelle').src, alt: tx(ig('seafood-tagliatelle').alt, lang) } },
  { key: 'desserts', items: desserts, photo: { src: ig('semifreddo-dark').src, alt: tx(ig('semifreddo-dark').alt, lang) } },
];
const tabs: { key: AnchorKey; label: string }[] = [
  { key: 'alacarte', label: m.tabs.alacarte },
  { key: 'weekly', label: m.tabs.weekly },
  { key: 'desserts', label: m.tabs.desserts },
  { key: 'seasonal', label: m.tabs.seasonal },
];
const allergenKeys = Object.keys(allergenLabels) as Allergen[];
---

<BaseLayout lang={lang} title={c.meta.menuTitle} description={c.meta.menuDescription} routeKey="menu">
  <Hero slot="hero" variant="page" lang={lang} routeKey="menu" image={photos.roastBeef} alt={m.heroAlt} eyebrow={m.eyebrow} title={m.title} position="50% 55%" />

  <section class="menu-intro section grain">
    <div class="container menu-intro__inner">
      <p class="lead" data-reveal>{m.intro}</p>
      <p class="menu-intro__meta" data-reveal>
        <span class="tag">{m.updated}: {formatDate(menuUpdated, lang)}</span>
        <span>{c.common.allergensNote}</span>
      </p>
    </div>
  </section>

  <nav class="menu-tabs" aria-label={m.eyebrow}>
    <ul class="container menu-tabs__list">
      {
        tabs.map((t) => (
          <li>
            <a class="menu-tabs__link" href={`#${anchorId(t.key, lang)}`} data-menu-tab>
              {t.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  {
    sections.map((s, i) => (
      <section id={anchorId(s.key, lang)} class:list={['menu-sec section', i % 2 === 1 && 'bg-sand', 'grain']} aria-labelledby={`menu-${s.key}`}>
        <div class="container menu-sec__grid">
          <header class="menu-sec__head">
            <p class="eyebrow">{String(i + 1).padStart(2, '0')}</p>
            <h2 id={`menu-${s.key}`} class="h2" data-split="chars">
              {m.sections[s.key].title}
            </h2>
            <p class="hand">{m.sections[s.key].note}</p>
            <figure class="frame menu-sec__photo" data-reveal>
              <Picture src={s.photo.src} alt={s.photo.alt} formats={['avif', 'webp']} widths={[360, 540, 640].filter((w) => w <= s.photo.src.width)} sizes="(max-width: 860px) 60vw, 28vw" loading="lazy" />
            </figure>
          </header>
          <div class="menu-sheet">
            <MenuList lang={lang} items={s.items} />
          </div>
        </div>
      </section>
    ))
  }

  <section id={anchorId('seasonal', lang)} class="menu-sec menu-seasonal section grain" aria-labelledby="menu-seasonal">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="eyebrow eyebrow--plain">04</p>
        <h2 id="menu-seasonal" class="h2" data-split="chars">{tx(seasonal.title, lang)}</h2>
        <p class="lead" data-reveal>{tx(seasonal.intro, lang)}</p>
      </div>

      <div class="set-menus">
        <figure class="frame set-menus__photo" data-reveal>
          <Picture src={photos.duckMorels} alt={c.offer.cards[1].alt} formats={['avif', 'webp']} widths={[480, 720, 960, 1280]} sizes="(max-width: 960px) 92vw, 30vw" loading="lazy" />
        </figure>
        {
          seasonal.menus.map((menu) => (
            <article class="set-menu" data-reveal>
              <header class="set-menu__head">
                <h3 class="set-menu__title">{tx(menu.title, lang)}</h3>
                <p class="set-menu__price">
                  {formatPrice(menu.price, lang)}
                  <span>{m.perPerson}</span>
                </p>
              </header>
              <ol class="set-menu__courses">
                {menu.courses.map((course, ci) => (
                  <li class="set-menu__course">
                    <span class="set-menu__num">
                      {ci + 1}. {m.course}
                    </span>
                    {course.options.map((opt, oi) => (
                      <>
                        {oi > 0 && <span class="set-menu__or">{m.or}</span>}
                        <span class="set-menu__dish">{tx(opt.name, lang)}</span>
                        {opt.allergens && (
                          <span class="set-menu__allergens">{opt.allergens.map((a) => tx(allergenLabels[a], lang)).join(' · ')}</span>
                        )}
                      </>
                    ))}
                  </li>
                ))}
              </ol>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="menu-legend section bg-sand grain" aria-labelledby="legend-title">
    <div class="container menu-legend__inner">
      <div>
        <h2 id="legend-title" class="eyebrow eyebrow--plain">{m.allergens}</h2>
        <ul class="menu-legend__list">
          {allergenKeys.map((a) => <li class="chip">{tx(allergenLabels[a], lang)}</li>)}
        </ul>
        <p class="menu-legend__note">{c.common.allergensNote}</p>
      </div>

      <div class="menu-cta" data-reveal>
        <h2 class="h3" set:html={m.ctaTitle} />
        <p>{m.ctaBody}</p>
        <div class="btn-row">
          <Button href={site.phoneHref} icon="phone" iconFirst magnetic>{phoneFor(lang)}</Button>
          <Button href={`mailto:${site.email}`} variant="ghost" icon="mail" iconFirst>{c.common.email}</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .menu-intro {
    padding-block: clamp(3rem, 6vw, 5rem) clamp(2rem, 4vw, 3rem);
  }

  .menu-intro__inner {
    display: grid;
    gap: 1.5rem;
  }

  .menu-intro__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    color: var(--ink-muted);
    font-size: 0.9375rem;
  }

  /* sticky tabs under the nav */
  .menu-tabs {
    position: sticky;
    top: var(--nav-h);
    z-index: 20;
    background: rgba(var(--bg-rgb), 0.94);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-block: 1px solid var(--line);
    transition: top 0.45s var(--ease-out);
  }

  :global(.nav.is-compact) ~ :global(.curtain) .menu-tabs {
    top: var(--nav-bar-h);
  }

  .menu-tabs__list {
    display: flex;
    gap: 0.25rem;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .menu-tabs__list::-webkit-scrollbar {
    display: none;
  }

  .menu-tabs__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 52px;
    padding-inline: 0.9rem;
    color: var(--ink-muted);
    font: 600 var(--fs-label) / 1 var(--font-body);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.3s;
  }

  .menu-tabs__link::after {
    content: '';
    position: absolute;
    left: 0.9rem;
    right: 0.9rem;
    bottom: -1px;
    height: 2px;
    background: var(--sage-deep);
    transform: scaleX(0);
    transition: transform 0.4s var(--ease-out);
  }

  .menu-tabs__link:hover,
  .menu-tabs__link[aria-current] {
    color: var(--ink);
  }

  .menu-tabs__link[aria-current]::after {
    transform: scaleX(1);
  }

  .menu-tabs__link:focus-visible {
    outline: 2px solid var(--sage-deep);
    outline-offset: -4px;
    border-radius: 6px;
  }

  .menu-sec {
    scroll-margin-top: calc(var(--nav-h) + 60px);
  }

  .menu-sec__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: start;
  }

  .menu-sec__head {
    position: sticky;
    top: calc(var(--nav-h) + 52px + 2rem);
    display: grid;
    gap: 1rem;
    justify-items: start;
  }

  .menu-sec__photo {
    width: min(100%, 360px);
    aspect-ratio: 4 / 5;
    margin: 1rem 0 0;
    rotate: -2deg;
  }

  .menu-sheet {
    padding: clamp(1.25rem, 3vw, 2.5rem);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  /* seasonal set menus */
  .set-menus {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
    align-items: stretch;
  }

  .set-menus__photo {
    margin: 0;
    min-height: 320px;
  }

  .set-menu {
    display: grid;
    align-content: start;
    gap: 1.5rem;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-align: center;
    outline: 1px solid var(--line);
    outline-offset: -10px;
  }

  .set-menu__head {
    display: grid;
    gap: 0.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px dotted var(--caramel);
  }

  .set-menu__title {
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    font-weight: 400;
  }

  .set-menu__price {
    display: grid;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 1.8rem + 1.5vw, 3rem);
    font-weight: 380;
    line-height: 1;
  }

  .set-menu__price span {
    margin-top: 0.4rem;
    color: var(--ink-muted);
    font: 500 0.8125rem / 1 var(--font-body);
    letter-spacing: 0.08em;
  }

  .set-menu__courses {
    display: grid;
    gap: 1.25rem;
  }

  .set-menu__course {
    display: grid;
    gap: 0.25rem;
  }

  .set-menu__num {
    color: var(--sage-deep);
    font: 600 0.6875rem / 1.2 var(--font-body);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .set-menu__dish {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 420;
    line-height: 1.3;
  }

  .set-menu__or {
    color: var(--ink-muted);
    font-family: var(--font-display);
    font-style: italic;
  }

  .set-menu__allergens {
    color: var(--ink-muted);
    font-size: 0.75rem;
  }

  /* legend + CTA */
  .menu-legend__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }

  .menu-legend__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 1.25rem 1rem;
  }

  .menu-legend__note {
    color: var(--ink-muted);
    font-size: 0.9375rem;
  }

  .menu-cta {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.75rem, 4vw, 3rem);
    background: var(--sage-soft);
    border-radius: var(--radius);
  }

  @media (max-width: 960px) {
    .set-menus {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .set-menus__photo {
      grid-column: 1 / -1;
      aspect-ratio: 16 / 9;
      min-height: 0;
    }

    .menu-legend__inner {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 860px) {
    .menu-sec__grid {
      grid-template-columns: 1fr;
    }

    .menu-sec__head {
      position: static;
    }

    .menu-sec__photo {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .set-menus {
      grid-template-columns: 1fr;
    }
  }
</style>
