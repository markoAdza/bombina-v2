---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import { copy } from '../i18n/copy';
import { href, tx, formatPrice, type Lang } from '../i18n/utils';
import { photos, ig } from '../data/images';
import { weekly, desserts, seasonal } from '../data/menu';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = copy[lang];

type Key = (typeof c.offer.cards)[number]['key'];
const media: Record<Key, { src: ImageMetadata; position?: string }> = {
  weekly: { src: photos.porkChopJus, position: '50% 40%' },
  seasonal: { src: photos.duckMorels, position: '45% 50%' },
  desserts: { src: ig('semifreddo-sun').src, position: '50% 60%' },
  catering: { src: photos.cateringSpread, position: '50% 70%' },
  name: { src: ig('interior-candles').src, position: '50% 40%' },
};
const links: Record<Key, string> = {
  weekly: href('menu', lang, 'weekly'),
  seasonal: href('menu', lang, 'seasonal'),
  desserts: href('menu', lang, 'desserts'),
  catering: href('catering', lang),
  name: href('home', lang, 'about'),
};
const tints = ['surface', 'sand', 'sage', 'surface', 'sand'];
const total = String(c.offer.cards.length).padStart(2, '0');

const priceOf = (p: number | [number, number]) => (Array.isArray(p) ? `${formatPrice(p[0], lang)} / ${formatPrice(p[1], lang)}` : formatPrice(p, lang));
---

<section class="offer section" aria-labelledby="offer-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow" data-reveal>{c.offer.eyebrow}</p>
      <h2 id="offer-title" class="h2" data-split="chars" set:html={c.offer.title} />
    </div>
  </div>

  <div class="stack container" data-stack>
    {
      c.offer.cards.map((card, i) => (
        <article class:list={['stack-card', `stack-card--${tints[i]}`]} style={`--i:${i}`} data-stack-card aria-labelledby={`card-${card.key}`}>
          <div class="stack-card__body">
            <div class="stack-card__top">
              <span class="stack-card__index">
                {String(i + 1).padStart(2, '0')}
                <span>/ {total}</span>
              </span>
              <span class="tag">{card.label}</span>
            </div>

            <div class="stack-card__text">
              <h3 id={`card-${card.key}`} class="h3" set:html={card.title} />
              <p>{card.body}</p>
            </div>

            {card.key === 'weekly' && (
              <ul class="stack-card__list">
                {weekly.map((item) => (
                  <li>
                    <span>{tx(item.name, lang)}</span>
                    <span class="stack-card__price">{priceOf(item.price)}</span>
                  </li>
                ))}
              </ul>
            )}
            {card.key === 'desserts' && (
              <ul class="stack-card__list">
                {desserts.map((item) => (
                  <li>
                    <span>{tx(item.name, lang)}</span>
                    <span class="stack-card__price">{priceOf(item.price)}</span>
                  </li>
                ))}
              </ul>
            )}
            {card.key === 'seasonal' && (
              <ul class="stack-card__list">
                {seasonal.menus.map((m) => (
                  <li>
                    <span>{tx(m.title, lang)}</span>
                    <span class="stack-card__price">{formatPrice(m.price, lang)}</span>
                  </li>
                ))}
              </ul>
            )}
            {card.key === 'catering' && (
              <ul class="stack-card__chips">
                {c.cateringPage.occasions.slice(0, 4).map((o) => (
                  <li class="chip">{o}</li>
                ))}
              </ul>
            )}
            {card.key === 'name' && (
              <p class="hand stack-card__hand" aria-hidden="true">
                Bombina bombina = Urh
              </p>
            )}

            <a class="link-arrow stack-card__link" href={links[card.key]}>
              <span>{card.cta}</span>
              <Icon name="arrow-right" />
            </a>
          </div>

          <div class="stack-card__media">
            <div class="stack-card__img" data-card-img>
              <Picture
                src={media[card.key].src}
                alt={card.alt}
                formats={['avif', 'webp']}
                widths={[480, 720, 960, 1200].filter((w) => w <= media[card.key].src.width)}
                sizes="(max-width: 700px) 92vw, 600px"
                loading="lazy"
                style={`object-position:${media[card.key].position ?? '50% 50%'}`}
              />
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .offer {
    padding-bottom: clamp(2rem, 6vw, 5rem);
  }

  .stack {
    display: grid;
    gap: 6vh;
    padding-bottom: 8vh;
  }

  .stack-card {
    --card-bg: var(--surface);
    --dim: 0;
    position: sticky;
    top: calc(var(--nav-h) + 1.25rem + var(--i) * 1.15rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
    gap: clamp(1.25rem, 3vw, 2.5rem);
    width: min(1180px, 100%);
    min-height: min(74vh, 640px);
    margin-inline: auto;
    padding: clamp(0.9rem, 1.6vw, 1.4rem);
    background: var(--card-bg);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-stack);
    transform-origin: 50% 0;
  }

  .stack-card::after {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    background: var(--ink);
    opacity: var(--dim);
    pointer-events: none;
  }

  .stack-card.is-unstuck {
    position: relative;
    top: auto;
  }

  .stack-card--sand {
    --card-bg: var(--surface-alt);
  }

  .stack-card--sage {
    --card-bg: var(--sage-soft);
  }

  .stack-card__body {
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 2vw, 1.5rem);
    padding: clamp(0.5rem, 1.5vw, 1.25rem);
  }

  .stack-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .stack-card--sage .tag {
    background: var(--surface);
  }

  .stack-card__index {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 400;
    font-variant-numeric: tabular-nums;
  }

  .stack-card__index span {
    color: var(--ink-muted);
    font-size: 0.875rem;
  }

  .stack-card__text {
    display: grid;
    gap: 1rem;
    margin-top: auto;
  }

  .stack-card__text p {
    max-width: 46ch;
  }

  .stack-card__list {
    display: grid;
    border-top: 1px solid var(--line);
  }

  .stack-card__list li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.6rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-size: var(--fs-small);
  }

  .stack-card__price {
    flex: none;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .stack-card__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .stack-card__hand {
    transform: rotate(-3deg);
    transform-origin: left;
  }

  .stack-card__link {
    align-self: flex-start;
  }

  .stack-card__media {
    position: relative;
    overflow: hidden;
    min-height: 240px;
    border-radius: calc(var(--radius) - 2px);
    border: 1px solid var(--line);
    background: var(--beige);
  }

  .stack-card__img {
    position: absolute;
    inset: -8% 0;
  }

  .stack-card__img :global(picture),
  .stack-card__img :global(img) {
    width: 100%;
    height: 100%;
  }

  .stack-card__img :global(img) {
    object-fit: cover;
    transition: transform 1.2s var(--ease-out);
  }

  .stack-card:hover .stack-card__img :global(img) {
    transform: scale(1.04);
  }

  @media (min-width: 861px) and (max-height: 820px) {
    .stack-card {
      min-height: min(64vh, 560px);
      top: calc(var(--nav-h) + 0.75rem + var(--i) * 0.7rem);
    }

    .stack-card__body {
      gap: 0.85rem;
    }
  }

  @media (max-width: 860px) {
    /* Fiksna višina (ne glede na vsebino) → kartica vedno pade v zaslon,
       ostane sticky in se pomanjša, ko jo prekrije naslednja. */
    .stack-card {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: minmax(0, 42%) minmax(0, 1fr);
      gap: 0.9rem;
      height: min(74svh, calc(100svh - var(--nav-h) - 7rem), 640px);
      min-height: 0;
      padding: 0.75rem;
      top: calc(var(--nav-h) + 0.75rem + var(--i) * 1rem);
    }

    .stack-card__media {
      order: -1;
      min-height: 0;
    }

    .stack-card__text {
      margin-top: 0;
      gap: 0.6rem;
    }

    .stack-card__body {
      min-height: 0;
      overflow: hidden;
      padding: 0.25rem 0.25rem 0.25rem;
      gap: 0.75rem;
    }

    .stack-card__text p {
      font-size: var(--fs-small);
      line-height: 1.5;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    /* seznam se po potrebi skrči, povezava ostane vidna */
    .stack-card__list,
    .stack-card__chips {
      min-height: 0;
      overflow: hidden;
    }

    .stack-card__link {
      margin-top: auto;
    }
  }

  @media (max-width: 600px) {
    .stack-card__list li:nth-child(n + 3) {
      display: none;
    }
  }

  /* Nizki telefoni: manj prostora fotografiji, več besedilu */
  @media (max-width: 860px) and (max-height: 720px) {
    .stack-card {
      grid-template-rows: minmax(0, 34%) minmax(0, 1fr);
    }

    .stack-card__text p {
      -webkit-line-clamp: 2;
      line-clamp: 2;
    }

    .stack-card__list,
    .stack-card__chips {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stack-card {
      position: relative;
      top: auto;
    }
  }
</style>
