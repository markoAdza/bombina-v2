---
import { Picture } from 'astro:assets';
import Button from './Button.astro';
import Icon from './Icon.astro';
import { copy } from '../i18n/copy';
import type { Lang } from '../i18n/utils';
import { collagePhotos, igPhotos } from '../data/images';
import { site } from '../data/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = copy[lang];

/** depth 1 = closest (moves most), 3 = furthest */
const slots = [
  { size: 'lg', depth: 2, rot: -4 },
  { size: 'sm', depth: 3, rot: 5 },
  { size: 'md', depth: 1, rot: 3 },
  { size: 'sm', depth: 3, rot: -5 },
  { size: 'lg', depth: 1, rot: 4 },
  { size: 'sm', depth: 3, rot: -3 },
  { size: 'md', depth: 2, rot: -3 },
  { size: 'sm', depth: 2, rot: 4 },
];
const tiles = collagePhotos.map((p, i) => ({ ...p, ...slots[i % slots.length], i }));

const half = Math.ceil(igPhotos.length / 2);
const rows = [igPhotos.slice(0, half), igPhotos.slice(half)];
---

<section class="insta section" aria-labelledby="insta-title">
  <div class="blob insta__blob" aria-hidden="true"></div>

  <div class="insta__stage" data-ig-stage>
    {
      tiles.map((t) => (
        <a
          class:list={['ig-tile', `ig-tile--${t.size}`, `ig-tile--${t.i}`]}
          style={`--depth:${t.depth};--rot:${t.rot}deg`}
          href={site.instagram}
          target="_blank"
          rel="noopener noreferrer"
          tabindex="-1"
          aria-hidden="true"
          data-ig-tile
          data-depth={t.depth}
        >
          <span class="ig-tile__inner">
            <Picture src={t.src} alt="" formats={['avif', 'webp']} widths={[240, 400, 640].filter((w) => w <= t.src.width)} sizes="(max-width: 860px) 38vw, 19vw" loading="lazy" />
            <span class="ig-tile__glyph">
              <Icon name="instagram" />
            </span>
          </span>
        </a>
      ))
    }

    <div class="insta__center">
      <p class="handle-pill" data-reveal>
        <Icon name="instagram" />
        {site.instagramHandle}
      </p>
      <h2 id="insta-title" class="h2 insta__title" data-split="chars" set:html={c.instagram.title} />
      <p class="insta__body" data-reveal>{c.instagram.body}</p>
      <div data-reveal>
        <Button href={site.instagram} external icon="arrow-right" magnetic aria-label={`${c.instagram.cta} ${site.instagramHandle} (Instagram)`}>
          {c.instagram.cta}
        </Button>
      </div>
    </div>
  </div>

  <div class="insta__strip" aria-hidden="true">
    {
      rows.map((row, r) => (
        <div class:list={['insta__row', r === 1 && 'insta__row--reverse']}>
          <div class="insta__track">
            {[0, 1].map(() =>
              row.map((p) => (
                <a class="strip-tile" href={site.instagram} target="_blank" rel="noopener noreferrer" tabindex="-1">
                  <Picture src={p.src} alt="" formats={['avif', 'webp']} widths={[240, 400].filter((w) => w <= p.src.width)} sizes="200px" loading="lazy" />
                  <span class="ig-tile__glyph">
                    <Icon name="instagram" />
                  </span>
                </a>
              )),
            )}
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .insta {
    overflow: clip;
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .insta__blob {
    top: 20%;
    left: 50%;
    translate: -50% 0;
    --blob-size: 60vw;
  }

  /* ---------------- Collage stage ---------------- */
  .insta__stage {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    min-height: clamp(640px, 108vh, 940px);
    padding-inline: var(--gutter);
  }

  .insta__center {
    position: relative;
    z-index: 5;
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    max-width: 28rem;
    text-align: center;
  }

  .insta__title {
    font-size: clamp(2.5rem, 1.4rem + 3.6vw, 4.5rem);
  }

  .insta__body {
    color: var(--ink-soft);
  }

  .ig-tile {
    --w: 10vw;
    position: absolute;
    left: var(--x, auto);
    right: var(--r, auto);
    top: var(--y, auto);
    bottom: var(--b, auto);
    z-index: calc(4 - var(--depth));
    width: var(--w);
    aspect-ratio: 4 / 5;
    rotate: var(--rot);
    border-radius: var(--radius);
    transition: rotate 0.6s var(--ease-out);
  }

  .ig-tile:hover {
    rotate: 0deg;
  }

  .ig-tile__inner {
    position: absolute;
    inset: 0;
    display: block;
    overflow: hidden;
    border-radius: inherit;
    background: var(--beige);
    box-shadow: var(--shadow-tile);
    translate: calc(var(--mx, 0) * (4 - var(--depth)) * 10px) calc(var(--my, 0) * (4 - var(--depth)) * 10px);
    transition: translate 0.9s var(--ease-out);
  }

  .ig-tile__inner :global(picture),
  .ig-tile__inner :global(img),
  .strip-tile :global(picture),
  .strip-tile :global(img) {
    width: 100%;
    height: 100%;
  }

  .ig-tile__inner :global(img),
  .strip-tile :global(img) {
    object-fit: cover;
    transition: transform 0.8s var(--ease-out);
  }

  .ig-tile:hover :global(img),
  .strip-tile:hover :global(img) {
    transform: scale(1.06);
  }

  .ig-tile__glyph {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--on-dark);
    background: rgba(var(--ink-rgb), 0.28);
    opacity: 0;
    transition: opacity 0.4s var(--ease-out);
  }

  .ig-tile__glyph :global(.icon) {
    width: 30px;
    height: 30px;
  }

  .ig-tile:hover .ig-tile__glyph,
  .strip-tile:hover .ig-tile__glyph {
    opacity: 1;
  }

  .ig-tile--lg {
    --w: clamp(150px, 19vw, 300px);
  }

  .ig-tile--md {
    --w: clamp(120px, 14vw, 220px);
  }

  .ig-tile--sm {
    --w: clamp(96px, 10vw, 160px);
  }

  .ig-tile--0 { --x: 3%; --y: 7%; }
  .ig-tile--1 { --x: 25%; --y: 1%; }
  .ig-tile--2 { --x: 8%; --y: 56%; }
  .ig-tile--3 { --x: 26%; --y: 76%; }
  .ig-tile--4 { --r: 3%; --y: 5%; }
  .ig-tile--5 { --r: 25%; --y: 2%; }
  .ig-tile--6 { --r: 8%; --y: 57%; }
  .ig-tile--7 { --r: 27%; --y: 79%; }

  /* ---------------- Marquee strip ---------------- */
  .insta__strip {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 0.75rem;
    margin-top: clamp(1rem, 3vw, 2rem);
  }

  .insta__row {
    overflow: hidden;
  }

  .insta__track {
    display: flex;
    gap: 0.75rem;
    width: max-content;
    animation: strip 90s linear infinite;
  }

  .insta__row--reverse .insta__track {
    animation-direction: reverse;
    margin-left: -6rem;
  }

  .insta__strip:hover .insta__track {
    animation-play-state: paused;
  }

  .strip-tile {
    position: relative;
    flex: none;
    width: clamp(140px, 14vw, 200px);
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--beige);
  }

  @keyframes strip {
    to {
      transform: translateX(calc(-50% - 0.375rem));
    }
  }

  /* ---------------- Tablet / mobile ---------------- */
  @media (max-width: 860px) {
    .insta__stage {
      min-height: 0;
      padding-block: 58vw 64vw;
    }

    .ig-tile--lg { --w: 36vw; }
    .ig-tile--md { --w: 27vw; }
    .ig-tile--sm { --w: 22vw; }

    .ig-tile--0 { --x: 3%; --y: 1.5rem; }
    .ig-tile--1 { --x: 42%; --y: 0.5rem; }
    .ig-tile--4 { --r: 3%; --y: 4rem; }
    .ig-tile--2 { --x: 4%; --y: auto; --b: 3rem; }
    .ig-tile--6 { --r: 4%; --y: auto; --b: 1rem; }
    .ig-tile--7 { --x: 40%; --r: auto; --y: auto; --b: 9rem; }
    .ig-tile--3,
    .ig-tile--5 {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .insta__track {
      animation: none;
    }
  }
</style>
