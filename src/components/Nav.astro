---
import Icon from './Icon.astro';
import Button from './Button.astro';
import LangToggle from './LangToggle.astro';
import { copy } from '../i18n/copy';
import { href, type Lang, type RouteKey } from '../i18n/utils';
import { site, hoursShort, phoneFor } from '../data/site';

interface Props {
  lang: Lang;
  routeKey: RouteKey | null;
}
const { lang, routeKey } = Astro.props;
const c = copy[lang].common;

const left = [
  { label: c.menu, href: href('menu', lang), current: routeKey === 'menu' },
  { label: c.catering, href: href('catering', lang), current: routeKey === 'catering' },
  { label: c.about, href: href('home', lang, 'about'), current: false },
];
const mobileLinks = [
  { label: c.home, href: href('home', lang), current: routeKey === 'home' },
  ...left,
  { label: c.visit, href: href('home', lang, 'visit'), current: false },
];
const stripItems = [`${c.reservations}: ${phoneFor(lang)}`, hoursShort[lang], `${site.address.street}, ${site.address.city}`];
---

<div class="nav-sentinel" data-nav-sentinel aria-hidden="true"></div>
<header class="nav" data-nav>
  <div class="nav__bar">
    <nav class="nav__side nav__side--left" aria-label={lang === 'sl' ? 'Glavna navigacija' : 'Main navigation'}>
      <ul class="nav__links">
        {
          left.map((l) => (
            <li>
              <a class="nav__link" href={l.href} aria-current={l.current ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
      <button class="nav__burger" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-open>
        <Icon name="menu" />
        <span class="visually-hidden">{c.openMenu}</span>
      </button>
    </nav>

    <a class="nav__brand" href={href('home', lang)} aria-label={`${site.name} — ${c.home}`}>
      <span class="mark mark--frog nav__frog" aria-hidden="true"></span>
      <span class="mark mark--bombina nav__wordmark" aria-hidden="true"></span>
    </a>

    <div class="nav__side nav__side--right">
      <a class="nav__link nav__link--contact" href={href('home', lang, 'visit')}>{c.visit}</a>
      <LangToggle lang={lang} routeKey={routeKey} />
      <Button href={site.phoneHref} size="sm" icon="phone" iconFirst magnetic class="nav__cta" aria-label={`${c.reserve}: ${phoneFor(lang)}`}>
        {c.reserve}
      </Button>
    </div>
  </div>

  <div class="nav__strip" aria-label={c.reservations}>
    <div class="nav__strip-track">
      {
        [0, 1].map((copyIndex) => (
          <p class="nav__strip-line" aria-hidden={copyIndex === 1 ? 'true' : undefined}>
            {stripItems.map((item, i) => (
              <>
                {i > 0 && <span class="nav__strip-dot" aria-hidden="true" />}
                {i === 0 && copyIndex === 0 ? <a href={site.phoneHref}>{item}</a> : <span>{item}</span>}
              </>
            ))}
          </p>
        ))
      }
    </div>
  </div>
</header>

<div class="mobile-menu grain" id="mobile-menu" role="dialog" aria-modal="true" aria-label={c.menu} hidden data-mobile-menu>
  <div class="mobile-menu__top">
    <a class="nav__brand" href={href('home', lang)} aria-label={`${site.name} — ${c.home}`}>
      <span class="mark mark--frog nav__frog" aria-hidden="true"></span>
      <span class="mark mark--bombina nav__wordmark" aria-hidden="true"></span>
    </a>
    <button class="nav__burger nav__burger--close" type="button" data-menu-close>
      <Icon name="x" />
      <span class="visually-hidden">{c.closeMenu}</span>
    </button>
  </div>
  <nav aria-label={lang === 'sl' ? 'Mobilna navigacija' : 'Mobile navigation'}>
    <ul class="mobile-menu__links">
      {
        mobileLinks.map((l, i) => (
          <li style={`--i:${i}`}>
            <a href={l.href} aria-current={l.current ? 'page' : undefined} data-menu-link>
              <span class="mobile-menu__num">0{i + 1}</span>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="mobile-menu__foot">
    <a class="mobile-menu__contact" href={site.phoneHref}><Icon name="phone" />{phoneFor(lang)}</a>
    <a class="mobile-menu__contact" href={`mailto:${site.email}`}><Icon name="mail" />{site.email}</a>
    <div class="mobile-menu__actions">
      <Button href={site.phoneHref} icon="phone" iconFirst>{c.reserveLong}</Button>
      <LangToggle lang={lang} routeKey={routeKey} />
    </div>
  </div>
</div>

<style>
  .nav-sentinel {
    height: 1px;
    margin-bottom: -1px;
  }

  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--nav-h);
    transition: translate 0.5s var(--ease-out);
  }

  .nav.is-away:not(:focus-within) {
    translate: 0 -110%;
  }

  .nav__bar {
    position: relative;
    z-index: 2;
    height: var(--nav-bar-h);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding-inline: var(--gutter);
    background: rgba(var(--bg-rgb), 0.94);
    backdrop-filter: saturate(1.2) blur(10px);
    -webkit-backdrop-filter: saturate(1.2) blur(10px);
    border-bottom: 1px solid var(--line);
    transition: box-shadow 0.4s var(--ease-out);
  }

  .nav.is-stuck .nav__bar {
    box-shadow: var(--shadow-subtle);
  }

  .nav__side {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 2rem);
  }

  .nav__side--right {
    justify-content: flex-end;
  }

  .nav__links {
    display: flex;
    gap: clamp(0.75rem, 2vw, 2rem);
  }

  .nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.25rem;
    color: var(--ink);
    text-decoration: none;
    font: 500 var(--fs-button) / 1 var(--font-body);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .nav__link::after {
    content: '';
    position: absolute;
    left: 0.25rem;
    right: 0.25rem;
    bottom: 0.7rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.45s var(--ease-out);
  }

  .nav__link:hover::after,
  .nav__link[aria-current='page']::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .nav__link:focus-visible {
    outline: 2px solid var(--sage-deep);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    color: var(--ink);
    text-decoration: none;
    border-radius: 6px;
  }

  .nav__brand:focus-visible {
    outline: 2px solid var(--sage-deep);
    outline-offset: 4px;
  }

  .nav__frog {
    height: 52px;
    transform-origin: 50% 90%;
    transition: transform 0.6s var(--ease-out);
  }

  .nav__brand:hover .nav__frog {
    transform: rotate(-6deg);
  }

  .nav__wordmark {
    height: 26px;
  }

  .nav__burger {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-left: -10px;
    border-radius: 999px;
    color: var(--ink);
    transition: background-color 0.3s;
  }

  .nav__burger:hover {
    background: var(--sage-soft);
  }

  .nav__burger :global(.icon) {
    width: 24px;
    height: 24px;
  }

  /* ---- Info strip (sage) ---- */
  .nav__strip {
    position: relative;
    z-index: 1;
    height: var(--nav-strip-h);
    overflow: hidden;
    background: var(--sage);
    color: var(--ink);
    font: 500 0.8125rem / 1 var(--font-body);
    letter-spacing: 0.04em;
    transition:
      transform 0.45s var(--ease-out),
      opacity 0.3s var(--ease-out);
  }

  .nav.is-compact .nav__strip {
    transform: translateY(-100%);
    opacity: 0;
  }

  .nav__strip-track {
    display: flex;
    justify-content: center;
    height: 100%;
  }

  .nav__strip-line {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex: none;
    padding-inline: 1rem;
    white-space: nowrap;
  }

  .nav__strip-line + .nav__strip-line {
    display: none;
  }

  .nav__strip a {
    color: inherit;
    text-decoration: none;
    font-weight: 600;
  }

  .nav__strip a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .nav__strip-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--sage-deep);
  }

  /* ---- Mobile menu ---- */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    flex-direction: column;
    padding: 0.75rem var(--gutter) max(1.5rem, env(safe-area-inset-bottom));
    background-color: var(--bg);
    overflow-y: auto;
    opacity: 0;
    transition: opacity 0.35s var(--ease-out);
  }

  .mobile-menu.is-open {
    opacity: 1;
  }

  .mobile-menu[hidden] {
    display: none;
  }

  .mobile-menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: calc(var(--nav-bar-h) - 0.75rem);
  }

  .nav__burger--close {
    display: inline-flex;
    margin: 0 -10px 0 0;
  }

  .mobile-menu > nav {
    flex: 1;
    display: flex;
    align-items: center;
  }

  .mobile-menu__links {
    display: grid;
    gap: 0.25rem;
    padding-block: 2rem;
  }

  .mobile-menu__links li {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.6s var(--ease-out),
      transform 0.6s var(--ease-out);
    transition-delay: calc(0.08s + var(--i) * 0.06s);
  }

  .mobile-menu.is-open .mobile-menu__links li {
    opacity: 1;
    transform: none;
  }

  .mobile-menu__links a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.4rem;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 10vw, 3.75rem);
    font-weight: 360;
    line-height: 1.05;
    text-decoration: none;
  }

  .mobile-menu__links a[aria-current='page'] {
    font-style: italic;
  }

  .mobile-menu__links a:hover,
  .mobile-menu__links a:focus-visible {
    font-style: italic;
    color: var(--sage-deep);
  }

  .mobile-menu__num {
    color: var(--ink-muted);
    font: 600 var(--fs-label) / 1 var(--font-body);
    letter-spacing: 0.16em;
  }

  .mobile-menu__foot {
    display: grid;
    gap: 0.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .mobile-menu__contact {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 44px;
    color: var(--ink-soft);
    text-decoration: none;
  }

  .mobile-menu__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.75rem;
  }

  @media (max-width: 1100px) {
    .nav__link--contact {
      display: none;
    }
  }

  @media (max-width: 1024px) {
    .nav__links {
      display: none;
    }

    .nav__burger {
      display: inline-flex;
    }

    .nav__frog {
      height: 44px;
    }

    .nav__wordmark {
      height: 22px;
    }

    /* the strip becomes a slow marquee */
    .nav__strip-track {
      justify-content: flex-start;
      width: max-content;
      animation: strip-marquee 32s linear infinite;
    }

    .nav__strip-line + .nav__strip-line {
      display: flex;
    }
  }

  @media (max-width: 600px) {
    .nav__side--right :global(.lang) {
      display: none;
    }

    .nav__side--right :global(.nav__cta) {
      width: 44px;
      padding: 0;
    }

    .nav__side--right :global(.nav__cta .btn__label) {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
  }

  @media (max-width: 380px) {
    .nav__wordmark {
      display: none;
    }
  }

  @keyframes strip-marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav__strip-track {
      animation: none;
      justify-content: center;
      width: auto;
    }

    .nav__strip-line + .nav__strip-line {
      display: none;
    }
  }
</style>
