---
import { copy } from '../i18n/copy';
import type { Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = copy[lang].footer;
---

<div class="frog-egg">
  <span class="hand frog-egg__hint" aria-hidden="true">{c.frogHint}</span>
  <button class="frog-egg__btn" type="button" aria-label={c.frogLabel} data-frog>
    <span class="frog-egg__bubble" aria-hidden="true">{c.frogHello}</span>
    <span class="mark mark--frog frog-egg__frog" aria-hidden="true"></span>
  </button>
  <span class="visually-hidden" aria-live="polite" data-frog-live data-text={c.frogHello}></span>
</div>

<style>
  .frog-egg {
    position: relative;
    display: inline-grid;
    justify-items: center;
  }

  .frog-egg__hint {
    position: absolute;
    left: -3.2rem;
    top: 0.6rem;
    color: var(--on-dark);
    font-size: 1.35rem;
    rotate: -12deg;
    transition: opacity 0.4s;
  }

  .frog-egg__btn {
    position: relative;
    display: grid;
    place-items: center;
    width: 96px;
    height: 104px;
    border-radius: 18px;
    color: var(--on-dark);
    cursor: pointer;
  }

  .frog-egg__btn:focus-visible {
    outline: 2px solid var(--on-dark);
    outline-offset: 4px;
  }

  .frog-egg__frog {
    height: 96px;
    transform-origin: 55% 95%;
  }

  .frog-egg__bubble {
    position: absolute;
    bottom: calc(100% + 6px);
    left: 50%;
    padding: 0.45rem 0.85rem 0.55rem;
    border-radius: 14px 14px 14px 3px;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font-hand);
    font-size: 1.5rem;
    line-height: 1;
    white-space: nowrap;
    box-shadow: var(--shadow-tile);
    opacity: 0;
    translate: -10% 8px;
    scale: 0.6;
    transform-origin: 0 100%;
    transition:
      opacity 0.3s var(--ease-out),
      translate 0.5s var(--ease-out),
      scale 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    pointer-events: none;
  }

  .frog-egg__btn:hover .frog-egg__bubble,
  .frog-egg__btn:focus-visible .frog-egg__bubble,
  .frog-egg__btn.is-waving .frog-egg__bubble {
    opacity: 1;
    translate: -10% 0;
    scale: 1;
  }

  .frog-egg__btn:hover .frog-egg__frog,
  .frog-egg__btn:focus-visible .frog-egg__frog,
  .frog-egg__btn.is-waving .frog-egg__frog {
    animation: bow 1.1s var(--ease-out);
  }

  .frog-egg:hover .frog-egg__hint,
  .frog-egg:focus-within .frog-egg__hint {
    opacity: 0;
  }

  @keyframes bow {
    0% {
      transform: rotate(0);
    }
    30% {
      transform: rotate(-12deg) translateY(2px);
    }
    55% {
      transform: rotate(-12deg) translateY(2px);
    }
    80% {
      transform: rotate(3deg);
    }
    100% {
      transform: rotate(0);
    }
  }
</style>
